# --- Database (PostgreSQL 15+ with pgvector) ---
DATABASE_URL=postgres://lfs:lfs@localhost:5432/lesson_factory
DATABASE_URL_TEST=postgres://lfs:lfs@localhost:5432/lesson_factory_test

# --- Auth ---
# 32+ random bytes, base64. Used to sign session cookies. Rotate to invalidate all sessions.
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-32
# First admin bootstrap: only honored while the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=nick@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me
# Public origin used for invite links
APP_ORIGIN=http://localhost:3000

# --- Object storage ---
# local = filesystem under STORAGE_LOCAL_DIR (dev/test). s3 = any S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Background jobs ---
# inline = run jobs in the web process (dev). worker = only the `npm run worker` process runs jobs.
JOBS_MODE=inline
JOBS_POLL_MS=1000

# --- ID Copilot (server-side only; never exposed to the browser) ---
# mock = deterministic offline provider (tests/CI). anthropic = Anthropic Messages API.
AI_PROVIDER=mock
AI_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Optional embeddings for pgvector retrieval. When empty, retrieval uses Postgres full-text search.
EMBEDDINGS_PROVIDER=none

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=
